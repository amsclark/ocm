# Copy to .env and set DB_PASSWORD. The stack will not start without it.
#
#   cp .env.example .env
#   docker compose up -d

# Database password for the application user. Required, no default.
DB_PASSWORD=

# Optional. Defaults to DB_PASSWORD.
#DB_ROOT_PASSWORD=

# Where the app listens on the host. Loopback on purpose — see the comment in
# docker-compose.yml before changing HTTP_BIND.
#HTTP_PORT=8080
#HTTP_BIND=127.0.0.1

# Admin login created on first start. Leave ADMIN_PASSWORD blank and one is
# generated and printed to the app log.
#ADMIN_USER=admin
#ADMIN_PASSWORD=

# Set to 1 behind a TLS-terminating reverse proxy. Leave 0 for local http.
#FORCE_HTTPS=0

# Database name and user. Change before the first start or not at all; the
# database volume is initialised with these.
#DB_NAME=cms
#DB_USER=ocm

# URL path the application is served under.
#BASE_URL=/cms

# Key that encrypts staff TOTP (two-factor) secrets before they are stored in
# the database. Leave it blank and the entrypoint generates one on first start
# and keeps it in the cms-custom volume at config/totp_encryption_key.
#
# Set it here only if you keep secrets in your own store, or run more than one
# app container against one database — they must all use the same key. Format:
# base64 of 32 random bytes. Generate one with
#   docker compose exec app php -r 'echo base64_encode(random_bytes(32)), "\n";'
# Changing the key makes every enrolled secret undecryptable and forces every
# user to set up their authenticator again.
#TOTP_ENCRYPTION_KEY=
